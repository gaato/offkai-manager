{
  "name": "offkai-manager",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "engines": {
    "node": ">=26.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/start.mjs",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm build && playwright test --project=chromium",
    "test:e2e:all": "pnpm build && playwright test",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:ui": "playwright test --ui",
    "commands:register": "node scripts/register-commands.ts",
    "test:scenario": "vitest run --project scenario"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@discordjs/builders": "^1.14.1",
    "@discordjs/formatters": "^0.6.2",
    "@discordjs/rest": "^2.6.3",
    "@lucide/svelte": "^1.0.1",
    "@stripe/connect-js": "^3.4.6",
    "better-sqlite3": "^13",
    "discord-api-types": "^0.38.57",
    "drizzle-orm": "^0.45",
    "pino": "^10.1.0",
    "stripe": "^23.0.0",
    "sveltekit-superforms": "^2.28.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.2",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7",
    "@types/node": "^26.0.0",
    "daisyui": "^5",
    "dependency-cruiser": "^17.3.6",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-svelte": "^3.13.0",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.49.1",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
