{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":timezone(Asia/Tokyo)"],
  "schedule": ["before 6am on friday"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Batch non-major updates into one PR and merge it once CI passes; majors get their own and stay manual.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "non-major dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
